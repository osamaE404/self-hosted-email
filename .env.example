# Copy to .env and fill in your own values. .env is gitignored — it never
# leaves the machine it's deployed on.

# The hostname mail is served from. This is what goes in your MX record
# and what mail clients (Thunderbird, Gmail app) connect to.
MAIL_HOSTNAME=mail.example.com

# The domain mail addresses live under (usually the bare form of the above).
MAIL_DOMAIN=example.com

# Used for postmaster/DMARC aggregate reports.
ADMIN_EMAIL=postmaster@example.com

# Path, on the host, to the TLS certificate + key for MAIL_HOSTNAME.
# See docs/caddy-integration.md if you're getting certs from a Caddy
# instance that already owns ports 80/443 for something else on the box.
TLS_CERT_PATH=./certs/fullchain.pem
TLS_KEY_PATH=./certs/privkey.pem
